# Настройки сервера семейного древа. Скопируйте этот файл в корень проекта под именем .env — сервер прочитает его сам.
# Все строки необязательные: без них сервер запустится на порту 3000 и сам создаст коды доступа
# (напечатает их при первом запуске и положит в access.json в папке данных).

# Порт и адрес, на которых слушает сервер. Здесь — вариант за nginx или Caddy.
# Без прокси: HOST=0.0.0.0, а TRUST_PROXY ниже убрать.
PORT=3000
HOST=127.0.0.1

# Папка с данными: db.json (древо), uploads (фото), backups (копии), journal.ndjson (журнал правок),
# access.json и secret.key (секреты). Её и нужно бэкапить. Относительный путь считается от корня проекта.
DATA_DIR=data

# Сколько своих обратных прокси стоит перед сервером: 1 — один nginx или Caddy, 2 — ещё и CDN перед ним.
# Прокси должен передавать Host, X-Forwarded-For и X-Forwarded-Proto.
# За прокси задавать обязательно: иначе защита от подбора кода считает всех посетителей одним адресом.
TRUST_PROXY=1

# Кодовое слово семьи (его вводят родные, оно же в ссылке-приглашении) и код хранителя древа.
# Не короче 8 символов и разные. Смена любого из них завершает все сессии.
FAMILY_CODE=
ADMIN_CODE=

# Название древа при самом первом запуске: «Древо семьи …» (фамилия в родительном падеже, например Листопадовых).
# Если не задавать, древо называется «Семейное древо». Потом название меняет хранитель на сайте.
FAMILY_SURNAME=

# Сколько мегабайт могут занять все фотографии вместе (по умолчанию 5000).
UPLOADS_LIMIT_MB=5000
